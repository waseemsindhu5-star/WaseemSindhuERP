<Application x:Class="WaseemSindhuERP.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="PrimaryDark" Color="#0B1020"/>
            <SolidColorBrush x:Key="PanelDark" Color="#111827"/>
            <SolidColorBrush x:Key="CardDark" Color="#1F2937"/>
            <SolidColorBrush x:Key="AccentBlue" Color="#3B82F6"/>
            <SolidColorBrush x:Key="AccentGreen" Color="#22C55E"/>
            <SolidColorBrush x:Key="AccentAmber" Color="#F59E0B"/>
            <SolidColorBrush x:Key="AccentPurple" Color="#8B5CF6"/>
            <SolidColorBrush x:Key="TextPrimary" Color="#F3F4F6"/>
            <SolidColorBrush x:Key="TextSecondary" Color="#A1A1AA"/>
            <Style TargetType="Button">
                <Setter Property="Background" Value="#1F2937"/>
                <Setter Property="Foreground" Value="#F3F4F6"/>
                <Setter Property="BorderBrush" Value="#374151"/>
                <Setter Property="Padding" Value="12,8"/>
                <Setter Property="Margin" Value="0,0,0,0"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
