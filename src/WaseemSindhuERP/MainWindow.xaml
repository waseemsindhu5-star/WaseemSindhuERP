<Window x:Class="WaseemSindhuERP.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Waseem Sindhu ERP"
        Height="760"
        Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="#0B1020"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="90"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#111827" BorderBrush="#1F2937" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Waseem Sindhu ERP" FontSize="28" FontWeight="Bold" Foreground="#F3F4F6"/>
                    <TextBlock Text=" | Business Management System" Margin="12,0,0,0" FontSize="15" Foreground="#A1A1AA" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Signed in: Admin" Foreground="#A1A1AA" FontSize="14" Margin="0,0,12,0"/>
                    <Button Content="Sign In" Width="90" Background="#2563EB" BorderBrush="#2563EB"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#111827" CornerRadius="14" Padding="16" Margin="0,0,16,0">
                <StackPanel>
                    <TextBlock Text="Main Menu" Foreground="#F3F4F6" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>
                    <Button Content="Dashboard" Height="42" Margin="0,0,0,10" Background="#1F2937"/>
                    <Button Content="Company Setup" Height="42" Margin="0,0,0,10"/>
                    <Button Content="Customers" Height="42" Margin="0,0,0,10"/>
                    <Button Content="Suppliers" Height="42" Margin="0,0,0,10"/>
                    <Button Content="Products" Height="42" Margin="0,0,0,10"/>
                    <Button Content="Sales" Height="42" Margin="0,0,0,10"/>
                    <Button Content="Purchase" Height="42" Margin="0,0,0,10"/>
                    <Button Content="Inventory" Height="42" Margin="0,0,0,10"/>
                    <Button Content="Accounts" Height="42" Margin="0,0,0,10"/>
                    <Button Content="Reports" Height="42" Margin="0,0,0,10"/>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Dashboard Overview" Foreground="#F3F4F6" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,18"/>

                <ItemsControl Grid.Row="1" ItemsSource="{Binding Metrics}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#1F2937" CornerRadius="12" Margin="0,0,12,12" Padding="18">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="{Binding Title}" Foreground="#A1A1AA" FontSize="13"/>
                                    <TextBlock Grid.Row="1" Text="{Binding Value}" Foreground="#F3F4F6" FontSize="28" FontWeight="Bold" Margin="0,8,0,4"/>
                                    <TextBlock Grid.Row="2" Text="{Binding Trend}" Foreground="{Binding Accent}" FontSize="12"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Grid.Row="2" Margin="0,14,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#1F2937" CornerRadius="12" Margin="0,0,12,0" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Recent Sales" Foreground="#F3F4F6" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="Invoice #001 - 120,000 PKR" Foreground="#A1A1AA" Margin="0,12,0,0"/>
                            <TextBlock Text="Invoice #002 - 85,500 PKR" Foreground="#A1A1AA" Margin="0,8,0,0"/>
                            <TextBlock Text="Invoice #003 - 64,200 PKR" Foreground="#A1A1AA" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="#1F2937" CornerRadius="12" Margin="12,0,0,0" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Stock Summary" Foreground="#F3F4F6" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="Raw Material: 540 units" Foreground="#A1A1AA" Margin="0,12,0,0"/>
                            <TextBlock Text="Finished Goods: 210 units" Foreground="#A1A1AA" Margin="0,8,0,0"/>
                            <TextBlock Text="Low Stock Alerts: 3 items" Foreground="#A1A1AA" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
